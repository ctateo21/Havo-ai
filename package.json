{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": { "node": "20.20.0", "npm": "10.9.2" },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "npm run check && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "managed-data:export": "tsx scripts/managed-data-migration.ts export",
    "managed-data:import": "tsx scripts/managed-data-migration.ts import",
    "managed-data:reconcile": "tsx scripts/managed-data-migration.ts reconcile",
    "managed-data:final-sync": "tsx scripts/managed-data-migration.ts final-sync",
    "managed-data:reverse-dry-run": "tsx scripts/managed-data-migration.ts reverse-dry-run",
    "managed-data:reverse-restore": "tsx scripts/managed-data-migration.ts reverse-restore",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npx --no-install tsx --test --test-concurrency=1 client/src/lib/*.test.ts server/*.test.ts server/integrations/*.test.ts",
    "test:live:county-tax": "tsx --test scripts/county-tax-live-contract.test.ts",
    "test:managed-data-rehearsal": "tsc --project tsconfig.managed-data-rehearsal.json && tsx scripts/run-managed-data-rehearsal.ts",
    "test:e2e": "playwright test"
  },
